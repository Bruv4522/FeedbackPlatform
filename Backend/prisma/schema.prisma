generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Review {
  id       Int      @id @default(autoincrement())
  dateTime DateTime @default(now())
  rating   Int
  isPublic Boolean
  body     String
  admins   String[]
}
