# ============================================
# Dependencies
# ============================================
Backend/node_modules/
Frontend/node_modules/

# ============================================
# Environment / Secrets
# ============================================
Backend/.env
Backend/.env.local
Backend/.env.development
Backend/.env.development.local
Backend/.env.test
Backend/.env.test.local
Backend/.env.production
Backend/.env.production.local

Frontend/.env
Frontend/.env.local
Frontend/.env.development
Frontend/.env.development.local
Frontend/.env.test
Frontend/.env.test.local
Frontend/.env.production
Frontend/.env.production.local

# Keep example environment files in Git
!Backend/.env.example
!Frontend/.env.example

# ============================================
# Build / Compiled Output
# ============================================
Backend/dist/
Backend/build/
Backend/out/

Frontend/dist/
Frontend/build/
Frontend/out/

# TypeScript
Backend/*.tsbuildinfo
Frontend/*.tsbuildinfo

# ============================================
# Vite
# ============================================
Frontend/.vite/

# ============================================
# Prisma Generated Client
# ============================================
Backend/src/generated/

# ============================================
# Logs
# ============================================
Backend/logs/
Backend/*.log
Backend/npm-debug.log*
Backend/yarn-debug.log*
Backend/pnpm-debug.log*

Frontend/logs/
Frontend/*.log
Frontend/npm-debug.log*
Frontend/yarn-debug.log*
Frontend/pnpm-debug.log*

# ============================================
# Testing / Coverage
# ============================================
Backend/coverage/
Backend/.nyc_output/

Frontend/coverage/
Frontend/.nyc_output/

# ============================================
# Frontend Caches
# ============================================
Frontend/.cache/
Frontend/.parcel-cache/
Frontend/.turbo/

# ============================================
# OS Files
# ============================================
.DS_Store
Thumbs.db
desktop.ini

# ============================================
# IDE / Editor
# ============================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

Backend/.idea/
Backend/*.iml

Frontend/.idea/
Frontend/*.iml

# ============================================
# Temporary Files
# ============================================
Backend/tmp/
Backend/temp/
Backend/*.tmp
Backend/*.temp

Frontend/tmp/
Frontend/temp/
Frontend/*.tmp
Frontend/*.temp

# ============================================
# Vercel / Netlify / Cloudflare
# ============================================
Backend/.vercel/
Backend/.netlify/
Backend/.wrangler/

Frontend/.vercel/
Frontend/.netlify/
Frontend/.wrangler/

# ============================================
# Miscellaneous
# ============================================
Backend/*.swp
Backend/*.swo

Frontend/*.swp
Frontend/*.swo
